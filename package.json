{
  "name": "exact-duration",
  "version": "0.1.1",
  "type": "module",
  "description": "Parse a duration string into milliseconds — 1h30m, PT1H30M, 1 hour 30 minutes — and refuse anything ambiguous instead of guessing. Zero dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Tom Ryan",
  "keywords": [
    "duration",
    "parse",
    "milliseconds",
    "timeout",
    "ttl",
    "iso8601",
    "strict",
    "config",
    "zero-dependency"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/api.test.mjs test/differential.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:pack": "node scripts/test-pack.mjs",
    "verify": "npm run build && npm test && npm run test:types && npm run test:pack",
    "bench": "node bench/bench.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@sapphire/duration": "^1.2.0",
    "duration-fns": "^3.0.2",
    "enhanced-ms": "^4.1.0",
    "iso8601-duration": "^2.1.2",
    "ms": "^2.1.3",
    "parse-duration": "^2.1.3",
    "timestring": "^7.0.0",
    "tinyduration": "^3.4.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atomics-hub/exact-duration.git"
  },
  "homepage": "https://github.com/Atomics-hub/exact-duration#readme",
  "bugs": {
    "url": "https://github.com/Atomics-hub/exact-duration/issues"
  }
}
